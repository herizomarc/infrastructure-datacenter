#cloud-config
# 1. ENVIRONNEMENT LINGUISTIQUE ET CLAVIER
bootcmd:
  - localectl set-keymap fr
  - localectl set-x11-keymap fr
locale: fr_FR.UTF-8

# 2. EXTENSION DYNAMIQUE DE LA PARTITION RACINE LVM
growpart:
  mode: auto
  devices: ['/']
  ignore_growroot_disabled: false

# 3. RAFAÎCHISSEMENT DES PAQUETS D'USINE RHEL
package_update: true

# 4. 🏆 AMORCE DE L'AGENT DE COMMUNICATION PROXMOX (Évite le blocage Still Creating)
packages:
  - qemu-guest-agent

runcmd:
  - [ systemctl, daemon-reload ]
  - [ systemctl, enable, --now, qemu-guest-agent ]

# 5. 🛡️ CRÉATION DE L'UTILISATEUR SECOPS ET INJECTION DE LA CLÉ DU RUNNER
users:
  - name: secops
    groups: wheel
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    shell: /bin/bash
    ssh_authorized_keys:
